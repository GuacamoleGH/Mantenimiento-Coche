@using CarCareTracker.Helper
@inject IConfigHelper config
@inject ITranslationHelper translator
@model GasRecordInputContainer
@{
    var userConfig = config.GetUserConfig(User);
    var useMPG = userConfig.UseMPG;
    var useUKMPG = userConfig.UseUKMPG;
    var userLanguage = userConfig.UserLanguage;
    var useThreeDecimals = userConfig.UseThreeDecimalGasCost;
    var useThreeDecimalsConsumption = userConfig.UseThreeDecimalGasConsumption;
    var useKwh = Model.UseKwh;
    var useHours = Model.UseHours;
    var isNew = Model.GasRecord.Id == 0;
    var useUnitFuelCost = userConfig.UseUnitForFuelCost;
    string consumptionUnit;
    string distanceUnit;
    if (useKwh)
    {
        consumptionUnit = "kWh";
    } else if (useUKMPG)
    {
        consumptionUnit = translator.Translate(userLanguage, "liters");
    }
    else
    {
        consumptionUnit = useMPG ? translator.Translate(userLanguage, "gallons") : translator.Translate(userLanguage, "liters");
    }
    if (useHours)
    {
        distanceUnit = translator.Translate(userLanguage, "hours");
    }
    else if (useUKMPG)
    {
        distanceUnit = translator.Translate(userLanguage, "miles");
    }
    else
    {
        distanceUnit = useMPG ? translator.Translate(userLanguage, "miles") : translator.Translate(userLanguage, "kilometers");
    }
}
<div class="modal-header">
    <h5 class="modal-title">@(isNew? translator.Translate(userLanguage, "Add New Gas Record") : translator.Translate(userLanguage, "Edit Gas Record"))<small style="display:none; @(isNew ? "" : "cursor:pointer;")" class="cached-banner ms-2 text-warning" onclick='@(isNew ? "" : $"showEditGasRecordModal({Model.GasRecord.Id}, true)")'>@translator.Translate(userLanguage, "Unsaved Changes")</small></h5>
    <button type="button" class="btn-close" onclick="hideAddGasRecordModal()" aria-label="Close"></button>
</div>
<div class="modal-body" onkeydown="handleEnter(this)">
    <form>
        <div class="form-group">
            <div class="row g-4">
                <div class="col-md-6 col-12 d-flex flex-column gap-3">
                    <input type="text" id="workAroundInput" style="height:0px; width:0px; display:none;">
                    <div>
                        <label for="gasRecordDate" class="form-label mb-1">@translator.Translate(userLanguage,"Date")</label>
                        <div class="input-group">
                            <input type="text" id="gasRecordDate" placeholder="@translator.Translate(userLanguage,"Date refueled")" class="form-control" value="@Model.GasRecord.Date">
                            <span class="input-group-text"><i class="bi bi-calendar-event"></i></span>
                        </div>
                    </div>
                    <div>
                        <label for="gasRecordMileage" class="form-label mb-1">@($"{translator.Translate(userLanguage,"Odometer Reading")} ({distanceUnit})")</label>
                        <div class="input-group">
                            <input type="number" inputmode="numeric" id="gasRecordMileage" class="form-control" placeholder="@translator.Translate(userLanguage,"Odometer reading when refueled")" value="@(isNew || Model.GasRecord.Mileage == default ? "" : Model.GasRecord.Mileage)">
                            @if (isNew)
                            {
                                <div class="input-group-text">
                                    <button type="button" class="btn btn-sm btn-primary zero-y-padding" onclick="getLastOdometerReadingAndIncrement('gasRecordMileage')" title="Calcular a partir del último kilometraje registrado"><i class="bi bi-plus"></i></button>
                                </div>
                            }
                        </div>
                    </div>
                    <div>
                        <label for="gasRecordGallons" class="form-label mb-1">@($"{translator.Translate(userLanguage, "Fuel Consumption")} ({consumptionUnit})")</label>
                        <input type="text" inputmode="decimal" onkeydown="interceptDecimalKeys(event)" onkeyup="@(useThreeDecimalsConsumption ? "fixDecimalInput(this, 3)" : "fixDecimalInput(this, 2)"); updateGasCostPreview();" oninput="updateGasCostPreview()" onchange="updateGasCostPreview()" id="gasRecordGallons" class="form-control" placeholder="@translator.Translate(userLanguage,"Amount of gas refueled")" value="@(isNew ? "" : Model.GasRecord.Gallons)">
                    </div>
                    <!-- Depósito lleno mantenido activo en segundo plano para cálculo automático de consumo -->
                    <input class="form-check-input d-none" type="checkbox" id="gasIsFillToFull" checked="checked">
                    <div class="d-flex flex-column gap-2 py-1">
                        <div class="dual-range-container @(Model.UseKwh ? "" : "d-none")">
                            <label for="gasSoc" class="form-label mb-1">@translator.Translate(userLanguage, "State of Charge")</label>
                            <div class="dual-range" id="gasSoc" data-min="0" data-max="100">
                                <div class="dual-range-highlight" style="width:@($"{Model.GasRecord.EndingSoc - Model.GasRecord.StartingSoc}%"); left:@($"{Model.GasRecord.StartingSoc}%")"></div>
                                <input type="range" class="form-range" min="0" max="100" value="@Model.GasRecord.StartingSoc" step="1" oninput="handleDualRangeSlider(this)" data-handle="min">
                                <input type="range" class="form-range" min="0" max="100" value="@Model.GasRecord.EndingSoc" step="1" oninput="handleDualRangeSlider(this)" data-handle="max">
                            </div>
                            <div class="dual-range-labels d-flex justify-content-between">
                                <label data-range-label="min">@($"{Model.GasRecord.StartingSoc}%")</label>
                                <label data-range-label="max">@($"{Model.GasRecord.EndingSoc}%")</label>
                            </div>
                        </div>
                        <div class="form-check form-switch mb-0">
                            <input class="form-check-input" type="checkbox" role="switch" id="gasIsMissed" checked="@Model.GasRecord.MissedFuelUp">
                            <label class="form-check-label text-nowrap" for="gasIsMissed" title="Marca esto si olvidaste registrar algún repostaje anterior, para no falsear el cálculo de l/100km">Omitir cálculo de consumo <i class="bi bi-info-circle text-secondary ms-1"></i></label>
                        </div>
                    </div>
                    <div>
                        <label for="GasRecordCost" class="form-label mb-1">@translator.Translate(userLanguage,"Cost")</label>
                        <input type="text" inputmode="decimal" onkeydown="interceptDecimalKeys(event)" onkeyup="@(useThreeDecimals ? "fixDecimalInput(this, 3)" : "fixDecimalInput(this, 2)"); updateGasCostPreview();" oninput="updateGasCostPreview()" onchange="updateGasCostPreview()" id="gasRecordCost" class="form-control mb-2" placeholder="@translator.Translate(userLanguage,"Cost of gas refueled")" value="@(isNew ? "" : Model.GasRecord.Cost)">
                        <input type="hidden" id="gasCostType" value="total">
                        <div id="gasCostCalculationPreview" class="p-2 rounded bg-body-tertiary border d-flex justify-content-between align-items-center mb-2 d-none" style="font-size: 0.88rem;">
                            <span class="text-body-secondary"><i class="bi bi-fuel-pump me-1"></i><span id="gasCostPreviewLabel">Precio por @(consumptionUnit == "litros" ? "litro" : consumptionUnit):</span></span>
                            <span id="gasCostPreviewValue" class="fw-bold text-success"></span>
                        </div>
                    </div>
                    <div>
                        <label for="gasRecordTag" class="form-label mb-1">@translator.Translate(userLanguage,"Tags(optional)")</label>
                        <select multiple class="form-select" id="gasRecordTag">
                            @foreach (string tag in Model.GasRecord.Tags)
                            {
                                <!option value="@tag">@tag</!option>
                            }
                        </select>
                    </div>
                    @await Html.PartialAsync("_ExtraField", Model.GasRecord.ExtraFields)
                </div>
                <div class="col-md-6 col-12 d-flex flex-column gap-3">
                    <div>
                        <label for="gasRecordNotes" class="form-label mb-1">@translator.Translate(userLanguage,"Notes(optional)")<a class="link-underline link-underline-opacity-0" onclick="showLinks(this)"><i class="bi bi-markdown ms-2"></i></a></label>
                        <textarea id="gasRecordNotes" class="form-control" rows="5">@Model.GasRecord.Notes</textarea>
                    </div>
                    <div class="d-flex flex-column gap-2">
                        @await Html.PartialAsync("_UploadedFiles", Model.GasRecord.Files)
                        @await Html.PartialAsync("_FileUploader", Model.GasRecord.Files.Any())
                    </div>
                    <div id="filesPendingUpload"></div>
                </div>
            </div>
        </div>
    </form>
</div>
<div class="modal-footer">
    @if (!isNew)
    {
        
        <button type="button" class="btn btn-danger" onclick="deleteGasRecord(@Model.GasRecord.Id)" style="margin-right:auto;">@translator.Translate(userLanguage,"Delete")</button>
    }
    <button type="button" class="btn btn-secondary" onclick="hideAddGasRecordModal()">@translator.Translate(userLanguage,"Cancel")</button>
    @if (isNew)
    {
        <button type="button" class="btn btn-primary" onclick="saveGasRecordToVehicle()">@translator.Translate(userLanguage,"Add New Gas Record")</button>
    }
    else if (!isNew)
    {
        <button type="button" class="btn btn-primary" onclick="saveGasRecordToVehicle(true)">@translator.Translate(userLanguage,"Edit Gas Record")</button>
    }
</div>

<script>
    var selectedSupplies = [];
    var copySuppliesAttachments = false;
    function getGasRecordModelData(){
        return { id: @Model.GasRecord.Id}
    }
    function updateGasCostPreview() {
        var gallonsVal = $("#gasRecordGallons").val();
        var costVal = $("#gasRecordCost").val();
        var costType = $("#gasCostType").val() || 'total';

        if (!gallonsVal || !costVal) {
            $("#gasCostCalculationPreview").addClass("d-none");
            return;
        }

        var gallons = globalParseFloat(gallonsVal);
        var cost = globalParseFloat(costVal);

        if (isNaN(gallons) || gallons <= 0 || isNaN(cost) || cost <= 0) {
            $("#gasCostCalculationPreview").addClass("d-none");
            return;
        }

        var singleUnit = decodeHTMLEntities('@(consumptionUnit == "litros" ? "litro" : (consumptionUnit == "gallons" ? "galón" : consumptionUnit))');

        if (costType === 'unit') {
            var total = (gallons * cost).toFixed(2);
            $("#gasCostPreviewLabel").text("Coste total estimado:");
            $("#gasCostPreviewValue").text(globalAppendCurrency(globalFloatToString(total)));
            $("#gasCostCalculationPreview").removeClass("d-none");
        } else {
            var unitPrice = (cost / gallons).toFixed(3);
            $("#gasCostPreviewLabel").text("Precio por " + singleUnit + ":");
            $("#gasCostPreviewValue").text(globalAppendCurrency(globalFloatToString(unitPrice)) + " / " + singleUnit);
            $("#gasCostCalculationPreview").removeClass("d-none");
        }
    }
    setTimeout(updateGasCostPreview, 100);
</script>
@if (isNew && userConfig.EnableAutoFillOdometer)
{
    <script>
        setLastOdometer('gasRecordMileage');
    </script>
}