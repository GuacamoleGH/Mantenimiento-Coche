@using CarCareTracker.Helper
@inject IConfigHelper config
@inject ITranslationHelper translator
@{
    var userConfig = config.GetUserConfig(User);
    var userLanguage = userConfig.UserLanguage;
}
@model ReportParameter

<h2 class="swal2-title mb-3">@translator.Translate(userLanguage, "Select Columns")</h2>

<div class="text-start">
    <div class="d-flex justify-content-between align-items-center mb-3 px-1">
        <span class="text-secondary small fw-medium">Selecciona las columnas a incluir:</span>
        <button type="button" class="btn btn-sm btn-outline-secondary rounded-pill px-3 py-1 extra-small text-light border-0 shadow-none" style="background: rgba(255, 255, 255, 0.08); outline: none !important;" onclick="toggleAllReportColumns()" id="toggleAllColumnsBtn">
            <i class="bi bi-check2-all me-1"></i>Seleccionar todo
        </button>
    </div>

    <div id="columnSelector" style="max-height: 48vh; overflow-y: auto;">
        <div class="d-flex flex-column gap-1 p-2 rounded-3" style="background: rgba(255, 255, 255, 0.02); border: 1px solid rgba(255, 255, 255, 0.06);">
            @foreach (string column in Model.VisibleColumns)
            {
                <label class="d-flex align-items-center gap-3 py-2 px-3 rounded-2 cursor-pointer user-select-none option-row" for="visibleColumn_@column">
                    <input class="form-check-input mt-0 column-default" type="checkbox" value="@column" id="visibleColumn_@column" checked>
                    <span class="text-light">@(translator.Translate(userLanguage, column == nameof(GenericReportModel.DataType) ? "Type" : column))</span>
                </label>
            }
            @foreach (string extraField in Model.ExtraFields)
            {
                <label class="d-flex align-items-center gap-3 py-2 px-3 rounded-2 cursor-pointer user-select-none option-row" for="extraField_@extraField">
                    <input class="form-check-input mt-0 column-extrafield" type="checkbox" value="@extraField" id="extraField_@extraField">
                    <span class="text-light">@extraField</span>
                </label>
            }
        </div>
    </div>

    <div class="p-2 mt-2 rounded-3" style="background: rgba(255, 255, 255, 0.02); border: 1px solid rgba(255, 255, 255, 0.06);">
        <label class="d-flex align-items-center gap-3 py-1 px-3 rounded-2 cursor-pointer user-select-none option-row mb-0" for="printIndividualRecordsCheck">
            <input class="form-check-input mt-0" type="checkbox" role="switch" id="printIndividualRecordsCheck">
            <span class="text-light">@translator.Translate(userLanguage, "Print Individual Records")</span>
        </label>
    </div>

    <div class="mt-2">
        <button type="button" id="reportAdvancedParameterToggle" class="btn btn-outline-secondary w-100 py-2 rounded-3 border-0 d-flex align-items-center justify-content-center gap-2" style="background: rgba(255, 255, 255, 0.04); color: #cbd5e1; outline: none !important; box-shadow: none !important;" onclick="showReportAdvancedParameters()">
            <i class="bi bi-sliders text-info"></i>
            <span>@translator.Translate(userLanguage, "Advanced Filters")</span>
        </button>
    </div>

    <div class="report-advanced-parameters d-none mt-3 p-3 rounded-3" style="background: rgba(255, 255, 255, 0.03); border: 1px solid rgba(255, 255, 255, 0.06);">
        <div class="fw-semibold text-secondary extra-small text-uppercase mb-2">@translator.Translate(userLanguage, "Filter by Tags")</div>
        <select class="form-select mb-2" id="tagSelector">
            <!option value="@TagFilter.Exclude">@translator.Translate(userLanguage, "Exclude Records with these Tags")</!option>
            <!option value="@TagFilter.IncludeOnly">@translator.Translate(userLanguage, "Only Include Records with these Tags")</!option>
        </select>
        <select multiple id="tagSelectorInput"></select>

        <div class="fw-semibold text-secondary extra-small text-uppercase mt-3 mb-2">@translator.Translate(userLanguage, "Filter by Date Range")</div>
        <div class="form-check form-switch mb-2">
            <input class="form-check-input" type="checkbox" role="switch" id="dateRangeSelector">
            <label class="form-check-label small text-secondary" for="dateRangeSelector">@translator.Translate(userLanguage, "Filter by Date Range")</label>
        </div>
        <div class="input-group">
            <span class="input-group-text">@translator.Translate(userLanguage, "From")</span>
            <input type="text" id="dateRangeStartDate" class="form-control" placeholder="@translator.Translate(userLanguage,"Start Date")">
            <span class="input-group-text">@translator.Translate(userLanguage, "To")</span>
            <input type="text" id="dateRangeEndDate" class="form-control" placeholder="@translator.Translate(userLanguage,"End Date")">
        </div>
    </div>
</div>

<script>
    function toggleAllReportColumns() {
        var checkboxes = $("#columnSelector input[type='checkbox']");
        var allChecked = checkboxes.length === checkboxes.filter(':checked').length;
        checkboxes.prop('checked', !allChecked);
        $("#toggleAllColumnsBtn").html(allChecked ? '<i class="bi bi-check2-all me-1"></i>Seleccionar todo' : '<i class="bi bi-x-lg me-1"></i>Deseleccionar todo');
    }
</script>
