@using CarCareTracker.Helper
@using CarCareTracker.Logic
@using System.Globalization
@using System.Security.Claims
@inject IConfigHelper config
@inject ITranslationHelper translator
@inject IUserLogic userLogic
@model Vehicle
@{
    var userConfig = config.GetUserConfig(User);
    var userLanguage = userConfig.UserLanguage;

    var currentUserIdClaim = User.FindFirst(ClaimTypes.NameIdentifier)?.Value;
    int currentUserId = -1;
    if (!string.IsNullOrEmpty(currentUserIdClaim)) int.TryParse(currentUserIdClaim, out currentUserId);
    bool canEdit = User.IsInRole(nameof(UserData.IsRootUser)) || userLogic.UserCanDirectlyEditVehicle(currentUserId, Model.Id);

    // --- Cálculo de estado de ITV ---
    int? itvDaysLeft = null;
    string itvBadgeClass = "badge bg-secondary";
    string itvStatusText = translator.Translate(userLanguage, "Not_Configured");
    string itvBorderClass = "border-secondary";
    string itvDotClass = "";
    if (!string.IsNullOrWhiteSpace(Model.ItvExpiry))
    {
        if (DateTime.TryParse(Model.ItvExpiry, CultureInfo.CurrentCulture, DateTimeStyles.None, out var itvDate))
        {
            var diff = (itvDate.Date - DateTime.Today).Days;
            itvDaysLeft = diff;
            if (diff < 0)
            {
                itvBadgeClass = "badge bg-danger text-white";
                itvStatusText = $"Vencida hace {Math.Abs(diff)} días";
                itvBorderClass = "border-danger";
                itvDotClass = "status-dot-danger";
            }
            else if (diff <= 30)
            {
                itvBadgeClass = "badge bg-warning text-dark";
                itvStatusText = $"Vence en {diff} días";
                itvBorderClass = "border-warning";
                itvDotClass = "status-dot-warning";
            }
            else
            {
                itvBadgeClass = "badge bg-success text-white";
                itvStatusText = $"Vigente ({diff} días)";
                itvBorderClass = "border-success";
                itvDotClass = "status-dot-success";
            }
        }
        else
        {
            itvStatusText = Model.ItvExpiry;
        }
    }

    // --- Cálculo de estado de Seguro ---
    int? insDaysLeft = null;
    string insBadgeClass = "badge bg-secondary";
    string insStatusText = translator.Translate(userLanguage, "Not_Configured");
    string insBorderClass = "border-secondary";
    string insDotClass = "";
    if (!string.IsNullOrWhiteSpace(Model.InsuranceExpiry))
    {
        if (DateTime.TryParse(Model.InsuranceExpiry, CultureInfo.CurrentCulture, DateTimeStyles.None, out var insDate))
        {
            var diff = (insDate.Date - DateTime.Today).Days;
            insDaysLeft = diff;
            if (diff < 0)
            {
                insBadgeClass = "badge bg-danger text-white";
                insStatusText = $"Vencido hace {Math.Abs(diff)} días";
                insBorderClass = "border-danger";
                insDotClass = "status-dot-danger";
            }
            else if (diff <= 30)
            {
                insBadgeClass = "badge bg-warning text-dark";
                insStatusText = $"Renovación en {diff} días";
                insBorderClass = "border-warning";
                insDotClass = "status-dot-warning";
            }
            else
            {
                insBadgeClass = "badge bg-info text-dark";
                insStatusText = $"En vigor ({diff} días)";
                insBorderClass = "border-info";
                insDotClass = "status-dot-success";
            }
        }
        else
        {
            insStatusText = Model.InsuranceExpiry;
        }
    }
}

<div class="cockpit-box mb-4 hideOnPrint">
    @if (!canEdit)
    {
        <div class="alert alert-info py-2 px-3 mb-3 d-flex align-items-center gap-2 rounded-3 small">
            <i class="bi bi-info-circle-fill fs-5"></i>
            <div>Estás consultando este vehículo en modo <strong>solo lectura</strong> (pertenece a otro usuario).</div>
        </div>
    }
    <div class="row align-items-center g-3">
        <!-- Fila Superior: Datos Principales del Coche y Acciones Rápidas -->
        <div class="col-12 col-lg-7 d-flex align-items-center flex-wrap gap-2">
            <span class="fs-4 fw-bold text-light">@($"{Model.Year} {Model.Make} {Model.Model}")</span>
            @if (!string.IsNullOrWhiteSpace(Model.LicensePlate))
            {
                <span class="garage-plate-badge">
                    <span class="plate-eu-strip">E</span>
                    <span class="plate-number font-monospace">@Model.LicensePlate</span>
                </span>
            }
            @if (!string.IsNullOrWhiteSpace(Model.Vin))
            {
                <span class="badge bg-dark bg-opacity-75 text-light border border-secondary px-2 py-1 font-monospace" style="cursor:pointer;" onclick="navigator.clipboard.writeText('@Model.Vin'); successToast('@translator.Translate(userLanguage, "Copy_VIN")');" title="Clic para copiar VIN">
                    <i class="bi bi-clipboard me-1 text-info"></i>VIN: @Model.Vin
                </span>
            }
        </div>

        @if (canEdit)
        {
            <!-- Botones de Acción Rápida (1-Click Actions) -->
            <div class="col-12 col-lg-5 text-lg-end d-flex flex-wrap gap-2 justify-content-lg-end">
                <button type="button" class="btn btn-sm btn-action-cockpit btn-success shadow-sm" onclick="showAddGasRecordModal()">
                    <i class="bi bi-fuel-pump-fill me-1"></i>@translator.Translate(userLanguage, "Add_Fuel")
                </button>
                <button type="button" class="btn btn-sm btn-action-cockpit btn-primary shadow-sm" onclick="showAddServiceRecordModal()">
                    <i class="bi bi-tools me-1"></i>@translator.Translate(userLanguage, "Add_Service")
                </button>
                <button type="button" class="btn btn-sm btn-action-cockpit btn-info text-dark shadow-sm" onclick="showAddOdometerRecordModal()">
                    <i class="bi bi-speedometer2 me-1"></i>@translator.Translate(userLanguage, "Add_Odometer")
                </button>
                <button type="button" class="btn btn-sm btn-action-cockpit btn-outline-danger shadow-sm" onclick="showAddCollisionRecordModal()">
                    <i class="bi bi-exclamation-triangle-fill me-1"></i>@translator.Translate(userLanguage, "Add_Repair")
                </button>
            </div>
        }
        else
        {
            <div class="col-12 col-lg-5 text-lg-end d-flex align-items-center justify-content-lg-end">
                <span class="badge bg-secondary-subtle text-secondary-emphasis border px-3 py-2 rounded-pill"><i class="bi bi-eye me-1"></i>Modo lectura (vehículo compartido)</span>
            </div>
        }
    </div>

    <hr class="my-3 opacity-25" />

    <!-- Fila Inferior: Tarjetas de ITV, Seguro y Ficha Técnica -->
    <div class="row g-3">
        <!-- Tarjeta de ITV -->
        <div class="col-12 col-md-6 col-xl-3">
            <div class="cockpit-card p-3 h-100 d-flex flex-column justify-content-between @itvBorderClass">
                <div class="d-flex align-items-center justify-content-between mb-2">
                    <span class="fw-semibold small text-light">
                        @if (!string.IsNullOrEmpty(itvDotClass)) { <span class="status-indicator-dot @itvDotClass"></span> }
                        <i class="bi bi-clipboard2-check-fill text-warning me-1"></i>@translator.Translate(userLanguage, "ITV_Inspection")
                    </span>
                    <span class="@itvBadgeClass small rounded-pill px-2 py-1">@itvStatusText</span>
                </div>
                <div class="small text-secondary d-flex justify-content-between align-items-center mt-auto">
                    <span>Próxima fecha:</span>
                    <strong class="font-monospace text-light">@(string.IsNullOrWhiteSpace(Model.ItvExpiry) ? "---" : Model.ItvExpiry)</strong>
                </div>
            </div>
        </div>

        <!-- Tarjeta de Seguro -->
        <div class="col-12 col-md-6 col-xl-3">
            <div class="cockpit-card p-3 h-100 d-flex flex-column justify-content-between @insBorderClass">
                <div class="d-flex align-items-center justify-content-between mb-2">
                    <span class="fw-semibold small text-light">
                        @if (!string.IsNullOrEmpty(insDotClass)) { <span class="status-indicator-dot @insDotClass"></span> }
                        <i class="bi bi-shield-fill-check text-info me-1"></i>@translator.Translate(userLanguage, "Insurance")
                    </span>
                    <span class="@insBadgeClass small rounded-pill px-2 py-1">@insStatusText</span>
                </div>
                <div class="small text-secondary d-flex justify-content-between align-items-center mt-auto">
                    <span class="text-truncate me-1">@(string.IsNullOrWhiteSpace(Model.InsuranceCompany) ? "Póliza:" : Model.InsuranceCompany)</span>
                    <strong class="font-monospace text-light">@(string.IsNullOrWhiteSpace(Model.InsuranceExpiry) ? "---" : Model.InsuranceExpiry)</strong>
                </div>
            </div>
        </div>

        <!-- Tarjeta de Ficha Técnica / Consumibles Motor -->
        <div class="col-12 col-xl-6">
            <div class="cockpit-card p-3 h-100">
                <div class="d-flex align-items-center justify-content-between mb-2">
                    <span class="fw-semibold small text-light"><i class="bi bi-gear-wide-connected text-success me-1"></i>@translator.Translate(userLanguage, "Technical_Specs")</span>
                    @if (canEdit)
                    {
                        <button type="button" class="btn btn-link btn-sm p-0 text-decoration-none small text-info" onclick="editVehicle(@Model.Id)">
                            <i class="bi bi-pencil-square me-1"></i>Editar datos
                        </button>
                    }
                </div>
                <div class="row g-2 small text-secondary">
                    <div class="col-6 col-sm-3">
                        <span class="d-block text-truncate text-muted">Motor:</span>
                        <strong class="text-light text-truncate d-block" title="@Model.EngineCode">@(string.IsNullOrWhiteSpace(Model.EngineCode) ? "---" : Model.EngineCode)</strong>
                    </div>
                    <div class="col-6 col-sm-3">
                        <span class="d-block text-truncate text-muted">Aceite:</span>
                        <strong class="text-light text-truncate d-block" title="@Model.EngineOil">@(string.IsNullOrWhiteSpace(Model.EngineOil) ? "---" : Model.EngineOil)</strong>
                    </div>
                    <div class="col-6 col-sm-3">
                        <span class="d-block text-truncate text-muted">Bujías:</span>
                        <strong class="text-light text-truncate d-block" title="@Model.SparkPlugs">@(string.IsNullOrWhiteSpace(Model.SparkPlugs) ? "---" : Model.SparkPlugs)</strong>
                    </div>
                    <div class="col-6 col-sm-3">
                        <span class="d-block text-truncate text-muted">Neumáticos:</span>
                        <strong class="text-light text-truncate d-block" title="@Model.TyreSizes">@(string.IsNullOrWhiteSpace(Model.TyreSizes) ? "---" : Model.TyreSizes)</strong>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
