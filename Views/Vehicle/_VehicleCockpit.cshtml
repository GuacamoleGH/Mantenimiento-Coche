@using CarCareTracker.Helper
@using CarCareTracker.Logic
@using System.Globalization
@using System.Security.Claims
@inject IConfigHelper config
@inject ITranslationHelper translator
@inject IUserLogic userLogic
@model Vehicle
@{
    var userConfig = config.GetUserConfig(User);
    var userLanguage = userConfig.UserLanguage;

    var currentUserIdClaim = User.FindFirst(ClaimTypes.NameIdentifier)?.Value;
    int currentUserId = -1;
    if (!string.IsNullOrEmpty(currentUserIdClaim)) int.TryParse(currentUserIdClaim, out currentUserId);
    bool canEdit = User.IsInRole(nameof(UserData.IsRootUser)) || userLogic.UserCanDirectlyEditVehicle(currentUserId, Model.Id);

    // --- Cálculo de estado de ITV ---
    int? itvDaysLeft = null;
    string itvBadgeClass = "badge bg-secondary";
    string itvStatusText = translator.Translate(userLanguage, "Not_Configured");
    string itvBorderClass = "border-secondary";
    string itvDotClass = "";
    if (!string.IsNullOrWhiteSpace(Model.ItvExpiry))
    {
        if (DateTime.TryParse(Model.ItvExpiry, CultureInfo.CurrentCulture, DateTimeStyles.None, out var itvDate))
        {
            var diff = (itvDate.Date - DateTime.Today).Days;
            itvDaysLeft = diff;
            if (diff < 0)
            {
                itvBadgeClass = "badge bg-danger text-white";
                itvStatusText = "Caducada";
                itvBorderClass = "border-danger";
                itvDotClass = "status-dot-danger";
            }
            else if (diff <= 30)
            {
                itvBadgeClass = "badge bg-warning text-dark";
                itvStatusText = "Próxima";
                itvBorderClass = "border-warning";
                itvDotClass = "status-dot-warning";
            }
            else
            {
                itvBadgeClass = "badge bg-success text-white";
                itvStatusText = "Vigente";
                itvBorderClass = "border-success";
                itvDotClass = "status-dot-success";
            }
        }
        else
        {
            itvStatusText = Model.ItvExpiry;
        }
    }

    // --- Cálculo de estado de Seguro ---
    int? insDaysLeft = null;
    string insBadgeClass = "badge bg-secondary";
    string insStatusText = translator.Translate(userLanguage, "Not_Configured");
    string insBorderClass = "border-secondary";
    string insDotClass = "";
    if (!string.IsNullOrWhiteSpace(Model.InsuranceExpiry))
    {
        if (DateTime.TryParse(Model.InsuranceExpiry, CultureInfo.CurrentCulture, DateTimeStyles.None, out var insDate))
        {
            var diff = (insDate.Date - DateTime.Today).Days;
            insDaysLeft = diff;
            if (diff < 0)
            {
                insBadgeClass = "badge bg-danger text-white";
                insStatusText = "Vencido";
                insBorderClass = "border-danger";
                insDotClass = "status-dot-danger";
            }
            else if (diff <= 30)
            {
                insBadgeClass = "badge bg-warning text-dark";
                insStatusText = "Por renovar";
                insBorderClass = "border-warning";
                insDotClass = "status-dot-warning";
            }
            else
            {
                insBadgeClass = "badge bg-success text-white";
                insStatusText = "Vigente";
                insBorderClass = "border-success";
                insDotClass = "status-dot-success";
            }
        }
        else
        {
            insStatusText = Model.InsuranceExpiry;
        }
    }
}

<div class="row g-3 mb-4 hideOnPrint">

    <div class="col-12">

        <div class="cockpit-box">
    @if (!canEdit)
    {
        <div class="alert alert-info py-2 px-3 mb-3 d-flex align-items-center gap-2 rounded-3 small">
            <i class="bi bi-info-circle-fill fs-5"></i>
            <div>Estás consultando este vehículo en modo <strong>solo lectura</strong> (pertenece a otro usuario).</div>
        </div>
    }

    <!-- Fila 1: Datos Principales y Botón General de Añadir -->
    <div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-3">
        <div class="d-flex align-items-center flex-wrap gap-2">
            <h1 class="h4 mb-0 fw-bold text-light">@($"{Model.Year} {Model.Make} {Model.Model}")</h1>
            @if (!string.IsNullOrWhiteSpace(Model.LicensePlate))
            {
                <span class="garage-plate-badge">
                    <span class="plate-eu-strip">E</span>
                    <span class="plate-number font-monospace">@Model.LicensePlate</span>
                </span>
            }
            @if (canEdit && !string.IsNullOrWhiteSpace(Model.Vin))
            {
                <button type="button" class="btn btn-sm badge bg-dark bg-opacity-75 text-light border border-secondary px-2 py-1 font-monospace d-inline-flex align-items-center" onclick="navigator.clipboard.writeText('@Model.Vin'); successToast('@translator.Translate(userLanguage, "Copy_VIN")');" title="Clic para copiar VIN" aria-label="Copiar número de bastidor VIN">
                    <i class="bi bi-clipboard me-1 text-info"></i>VIN: @Model.Vin
                </button>
            }
            <span class="badge @(Model.IsPublic ? "bg-info text-dark" : "bg-secondary text-light") border border-secondary px-2 py-1 font-monospace" title="@(Model.IsPublic ? "Vehículo público: otros usuarios pueden verlo en modo lectura" : "Vehículo privado: solo visible para ti")">
                <i class="bi @(Model.IsPublic ? "bi-globe2" : "bi-lock-fill") me-1"></i>@(Model.IsPublic ? "Público" : "Privado")
            </span>
        </div>

        @if (canEdit)
        {
            <!-- Botón General de Añadir Registro (+ Dropdown Completo) -->
            <div class="dropdown">
                <button type="button" class="btn btn-warning fw-bold d-inline-flex align-items-center gap-2 px-3 py-2 shadow-sm rounded-3 dropdown-toggle btn-quick-add-main" data-bs-toggle="dropdown" aria-expanded="false" id="quickAddRecordDropdownBtn">
                    <i class="bi bi-plus-circle-fill fs-6"></i>
                    <span>Añadir</span>
                </button>
                <ul class="dropdown-menu dropdown-menu-dark dropdown-menu-end shadow-lg py-2 border-secondary border-opacity-25" style="min-width: 270px; z-index: 1060;" aria-labelledby="quickAddRecordDropdownBtn">
                    <li class="dropdown-header text-uppercase text-secondary small fw-bold px-3 py-1"><i class="bi bi-tools me-2 text-warning"></i>Mantenimiento y Uso</li>
                    <li><button class="dropdown-item d-flex align-items-center gap-2 py-2" onclick="quickAddRecord('GasRecord')"><i class="bi bi-fuel-pump text-success fs-6"></i><span>Repostaje</span></button></li>
                    <li><button class="dropdown-item d-flex align-items-center gap-2 py-2" onclick="quickAddRecord('ServiceRecord')"><i class="bi bi-tools text-warning fs-6"></i><span>Mantenimiento / Servicio</span></button></li>
                    <li><button class="dropdown-item d-flex align-items-center gap-2 py-2" onclick="quickAddRecord('RepairRecord')"><i class="bi bi-exclamation-triangle text-danger fs-6"></i><span>Avería / Reparación</span></button></li>
                    <li><button class="dropdown-item d-flex align-items-center gap-2 py-2" onclick="quickAddRecord('OdometerRecord')"><i class="bi bi-speedometer2 text-info fs-6"></i><span>Lectura de kilometraje</span></button></li>

                    <li><hr class="dropdown-divider user-dropdown-divider my-1"></li>
                    <li class="dropdown-header text-uppercase text-secondary small fw-bold px-3 py-1"><i class="bi bi-calendar-check me-2 text-primary"></i>Planificación</li>
                    <li><button class="dropdown-item d-flex align-items-center gap-2 py-2" onclick="quickAddRecord('ReminderRecord')"><i class="bi bi-bell text-warning fs-6"></i><span>Recordatorio</span></button></li>
                    <li><button class="dropdown-item d-flex align-items-center gap-2 py-2" onclick="quickAddRecord('PlanRecord')"><i class="bi bi-clipboard-check text-primary fs-6"></i><span>Plan / Checklist de tareas</span></button></li>
                    <li><button class="dropdown-item d-flex align-items-center gap-2 py-2" onclick="quickAddRecord('InspectionRecord')"><i class="bi bi-check2-square text-success fs-6"></i><span>Inspección técnica</span></button></li>

                    <li><hr class="dropdown-divider user-dropdown-divider my-1"></li>
                    <li class="dropdown-header text-uppercase text-secondary small fw-bold px-3 py-1"><i class="bi bi-wallet2 me-2 text-success"></i>Gastos y Gestión</li>
                    <li><button class="dropdown-item d-flex align-items-center gap-2 py-2" onclick="quickAddRecord('TaxRecord')"><i class="bi bi-currency-dollar text-success fs-6"></i><span>Gasto / Impuesto / Tasa</span></button></li>
                    <li><button class="dropdown-item d-flex align-items-center gap-2 py-2" onclick="quickAddRecord('UpgradeRecord')"><i class="bi bi-stars text-info fs-6"></i><span>Mejora / Modificación</span></button></li>
                    <li><button class="dropdown-item d-flex align-items-center gap-2 py-2" onclick="quickAddRecord('NoteRecord')"><i class="bi bi-journal-text text-light fs-6"></i><span>Nota / Apunte</span></button></li>
                    <li><button class="dropdown-item d-flex align-items-center gap-2 py-2" onclick="quickAddRecord('EquipmentRecord')"><i class="bi bi-disc text-primary fs-6"></i><span>Equipamiento / Accesorio</span></button></li>
                </ul>
            </div>
        }
        else
        {
            <div>
                <span class="badge bg-secondary-subtle text-secondary-emphasis border px-3 py-2 rounded-pill"><i class="bi bi-eye me-1"></i>Modo lectura</span>
            </div>
        }
    </div>

    @if (canEdit)
    {
        <!-- Fila 2: Acciones Rápidas Habituales (1-Click) -->
        <div class="d-flex flex-wrap gap-2 mb-3">
            <button type="button" class="btn btn-sm btn-action-cockpit d-inline-flex align-items-center" onclick="quickAddRecord('GasRecord')" title="@translator.Translate(userLanguage, "Add_Fuel")">
                <i class="bi bi-fuel-pump-fill text-success me-2 fs-6"></i><span>@translator.Translate(userLanguage, "Add_Fuel")</span>
            </button>
            <button type="button" class="btn btn-sm btn-action-cockpit d-inline-flex align-items-center" onclick="quickAddRecord('ServiceRecord')" title="@translator.Translate(userLanguage, "Add_Service")">
                <i class="bi bi-tools text-warning me-2 fs-6"></i><span>@translator.Translate(userLanguage, "Add_Service")</span>
            </button>
            <button type="button" class="btn btn-sm btn-action-cockpit d-inline-flex align-items-center" onclick="quickAddRecord('OdometerRecord')" title="@translator.Translate(userLanguage, "Add_Odometer")">
                <i class="bi bi-speedometer2 text-info me-2 fs-6"></i><span>@translator.Translate(userLanguage, "Add_Odometer")</span>
            </button>
            <button type="button" class="btn btn-sm btn-action-cockpit d-inline-flex align-items-center" onclick="quickAddRecord('RepairRecord')" title="@translator.Translate(userLanguage, "Add_Repair")">
                <i class="bi bi-exclamation-triangle-fill text-danger me-2 fs-6"></i><span>@translator.Translate(userLanguage, "Add_Repair")</span>
            </button>
        </div>
    }

    <!-- Fila Inferior: Tarjetas de ITV, Seguro y Ficha Técnica -->
    <div class="row g-3">
        <!-- Tarjeta de ITV -->
        <div class="col-12 col-md-6 col-xl-3">
            <div class="cockpit-card p-3 h-100 d-flex flex-column justify-content-between">
                <div class="d-flex align-items-center justify-content-between gap-2 mb-1">
                    <span class="fw-semibold small text-light text-nowrap d-flex align-items-center">
                        @if (!string.IsNullOrEmpty(itvDotClass)) { <span class="status-indicator-dot @itvDotClass"></span> }
                        <i class="bi bi-clipboard2-check-fill text-warning me-2"></i>@translator.Translate(userLanguage, "ITV_Inspection")
                    </span>
                    <span class="@itvBadgeClass small rounded-pill px-2 py-1 text-nowrap flex-shrink-0">@itvStatusText</span>
                </div>

                <!-- Cuerpo Central Informativo -->
                <div class="my-auto py-2">
                    @if (itvDaysLeft.HasValue)
                    {
                        <div class="d-flex align-items-center justify-content-between">
                            <div>
                                <div class="text-secondary small mb-1">Plazo de inspección</div>
                                @if (itvDaysLeft < 0)
                                {
                                    <div class="d-flex align-items-baseline gap-2 cockpit-val-danger">
                                        <span class="fs-3 fw-bold font-monospace">@Math.Abs(itvDaysLeft.Value)</span>
                                        <span class="small fw-semibold">días caducada</span>
                                    </div>
                                }
                                else if (itvDaysLeft <= 30)
                                {
                                    <div class="d-flex align-items-baseline gap-2 cockpit-val-warning">
                                        <span class="fs-3 fw-bold font-monospace">@itvDaysLeft.Value</span>
                                        <span class="small fw-semibold">días restantes</span>
                                    </div>
                                }
                                else
                                {
                                    <div class="d-flex align-items-baseline gap-2 cockpit-val-success">
                                        <span class="fs-3 fw-bold font-monospace">@itvDaysLeft.Value</span>
                                        <span class="small fw-semibold">días restantes</span>
                                    </div>
                                }
                            </div>
                            <div class="pe-1">
                                <i class="bi bi-shield-check fs-2 @(itvDaysLeft < 0 ? "icon-watermark-danger" : (itvDaysLeft <= 30 ? "icon-watermark-warning" : "icon-watermark-success"))"></i>
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="d-flex align-items-center justify-content-between">
                            <div>
                                <div class="text-secondary small mb-1">Inspección periódica</div>
                                <div class="small text-muted">Sin fecha registrada</div>
                            </div>
                            @if (canEdit)
                            {
                                <button type="button" class="btn btn-sm btn-outline-warning py-0 px-2 small" onclick="editVehicle(@Model.Id)" title="Configurar fecha de ITV">
                                    <i class="bi bi-plus-lg me-1"></i>Añadir
                                </button>
                            }
                        </div>
                    }
                </div>

                <div class="small text-secondary d-flex justify-content-between align-items-center pt-2 border-top border-secondary border-opacity-25 mt-auto">
                    <span class="text-nowrap me-1">Próxima fecha:</span>
                    <strong class="font-monospace text-light text-nowrap">@(string.IsNullOrWhiteSpace(Model.ItvExpiry) ? "---" : Model.ItvExpiry)</strong>
                </div>
            </div>
        </div>

        <!-- Tarjeta de Seguro -->
        <div class="col-12 col-md-6 col-xl-3">
            <div class="cockpit-card p-3 h-100 d-flex flex-column justify-content-between">
                <div class="d-flex align-items-center justify-content-between gap-2 mb-1">
                    <span class="fw-semibold small text-light text-nowrap d-flex align-items-center">
                        @if (!string.IsNullOrEmpty(insDotClass)) { <span class="status-indicator-dot @insDotClass"></span> }
                        <i class="bi bi-shield-fill-check text-info me-2"></i>@translator.Translate(userLanguage, "Insurance")
                    </span>
                    <span class="@insBadgeClass small rounded-pill px-2 py-1 text-nowrap flex-shrink-0">@insStatusText</span>
                </div>

                <!-- Cuerpo Central Informativo -->
                <div class="my-auto py-2">
                    @if (insDaysLeft.HasValue || !string.IsNullOrWhiteSpace(Model.InsuranceCompany))
                    {
                        <div class="d-flex align-items-center justify-content-between">
                            <div>
                                <div class="text-secondary small mb-1 text-truncate" style="max-width: 145px;" title="@Model.InsuranceCompany">@(string.IsNullOrWhiteSpace(Model.InsuranceCompany) ? "Póliza vigente" : Model.InsuranceCompany)</div>
                                @if (insDaysLeft.HasValue)
                                {
                                    if (insDaysLeft < 0)
                                    {
                                        <div class="d-flex align-items-baseline gap-2 cockpit-val-danger">
                                            <span class="fs-3 fw-bold font-monospace">@Math.Abs(insDaysLeft.Value)</span>
                                            <span class="small fw-semibold">días vencido</span>
                                        </div>
                                    }
                                    else if (insDaysLeft <= 30)
                                    {
                                        <div class="d-flex align-items-baseline gap-2 cockpit-val-warning">
                                            <span class="fs-3 fw-bold font-monospace">@insDaysLeft.Value</span>
                                            <span class="small fw-semibold">días de cobertura</span>
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="d-flex align-items-baseline gap-2 cockpit-val-success">
                                            <span class="fs-3 fw-bold font-monospace">@insDaysLeft.Value</span>
                                            <span class="small fw-semibold">días de cobertura</span>
                                        </div>
                                    }
                                }
                                else
                                {
                                    <div class="small text-light">Póliza configurada</div>
                                }
                            </div>
                            <div class="pe-1">
                                <i class="bi bi-file-earmark-medical fs-2 @(insDaysLeft < 0 ? "icon-watermark-danger" : (insDaysLeft <= 30 ? "icon-watermark-warning" : "icon-watermark-success"))"></i>
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="d-flex align-items-center justify-content-between">
                            <div>
                                <div class="text-secondary small mb-1">Póliza y seguro</div>
                                <div class="small text-muted">Sin seguro registrado</div>
                            </div>
                            @if (canEdit)
                            {
                                <button type="button" class="btn btn-sm btn-outline-info py-0 px-2 small" onclick="editVehicle(@Model.Id)" title="Configurar seguro">
                                    <i class="bi bi-plus-lg me-1"></i>Añadir
                                </button>
                            }
                        </div>
                    }
                </div>

                <div class="small text-secondary d-flex justify-content-between align-items-center pt-2 border-top border-secondary border-opacity-25 mt-auto">
                    <span class="text-nowrap me-1">Vencimiento:</span>
                    <strong class="font-monospace text-light text-nowrap">@(string.IsNullOrWhiteSpace(Model.InsuranceExpiry) ? "---" : Model.InsuranceExpiry)</strong>
                </div>
            </div>
        </div>

        <!-- Tarjeta de Ficha Técnica / Consumibles Motor (Legible sin truncar) -->
        <div class="col-12 col-xl-6">
            <div class="cockpit-card p-3 h-100">
                <div class="d-flex align-items-center justify-content-between mb-2">
                    <span class="fw-semibold small text-light">
                        <i class="bi bi-gear-wide-connected text-success me-1"></i>@translator.Translate(userLanguage, "Technical_Specs")
                    </span>
                    @if (canEdit)
                    {
                        <button type="button" class="btn btn-link btn-sm p-0 text-decoration-none small text-info" onclick="editVehicle(@Model.Id)">
                            <i class="bi bi-pencil-square me-1"></i>Editar datos
                        </button>
                    }
                </div>
                <div class="spec-grid">
                    <div class="spec-item spec-item-motor">
                        <div class="spec-info">
                            <div class="spec-label spec-label-motor"><i class="bi bi-cpu me-1"></i>Motor</div>
                            <div class="spec-value">@(string.IsNullOrWhiteSpace(Model.EngineCode) ? "---" : Model.EngineCode)</div>
                        </div>
                    </div>
                    <div class="spec-item spec-item-aceite">
                        <div class="spec-info">
                            <div class="spec-label spec-label-aceite"><i class="bi bi-droplet-half me-1"></i>Aceite</div>
                            <div class="spec-value">@(string.IsNullOrWhiteSpace(Model.EngineOil) ? "---" : Model.EngineOil)</div>
                        </div>
                    </div>
                    <div class="spec-item spec-item-bujias">
                        <div class="spec-info">
                            <div class="spec-label spec-label-bujias"><i class="bi bi-lightning-charge me-1"></i>Bujías</div>
                            <div class="spec-value">@(string.IsNullOrWhiteSpace(Model.SparkPlugs) ? "---" : Model.SparkPlugs)</div>
                        </div>
                    </div>
                    <div class="spec-item spec-item-ruedas">
                        <div class="spec-info">
                            <div class="spec-label spec-label-ruedas"><i class="bi bi-disc me-1"></i>Neumáticos</div>
                            <div class="spec-value">@(string.IsNullOrWhiteSpace(Model.TyreSizes) ? "---" : Model.TyreSizes)</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
    </div>
</div>
