@using CarCareTracker.Helper
@inject IConfigHelper config
@inject ITranslationHelper translator
@{
    var userLanguage = config.GetServerLanguage();
}
@model LoginModel
@{
    ViewData["Title"] = "Registro de Usuario";
}
@section Scripts {
    <script src="~/js/login.js?v=@StaticHelper.VersionNumber"></script>
}
<style>
    body {
        background-color: #111722 !important;
        background: #111722 !important;
    }
    .card.login-card,
    .card.login-card:hover,
    [data-bs-theme="dark"] .card.login-card,
    [data-bs-theme="dark"] .card.login-card:hover {
        transform: none !important;
        transition: none !important;
        cursor: default !important;
        background-color: #191F2C !important;
        border: 1px solid #30394A !important;
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.45) !important;
    }

    .login-field-box {
        background-color: #252E3F !important;
        border: 1px solid #30394A !important;
        border-radius: 8px !important;
        display: flex !important;
        align-items: center !important;
        height: 46px !important;
        overflow: hidden !important;
        padding: 0 !important;
        transition: border-color 0.15s ease-in-out, box-shadow 0.15s ease-in-out !important;
    }
    .login-field-box:focus-within {
        border-color: #FBC41E !important;
        box-shadow: 0 0 0 0.2rem rgba(251, 196, 30, 0.25) !important;
    }
    .login-field-icon {
        width: 44px !important;
        min-width: 44px !important;
        height: 100% !important;
        display: flex !important;
        align-items: center !important;
        justify-content: center !important;
        color: #A0AABD !important;
        font-size: 1.15rem !important;
        border: none !important;
        background: transparent !important;
        flex-shrink: 0 !important;
    }
    .login-field-icon i {
        display: inline-flex !important;
        align-items: center !important;
        justify-content: center !important;
        line-height: 1 !important;
    }
    .login-field-input {
        flex: 1 !important;
        height: 100% !important;
        background: transparent !important;
        background-color: transparent !important;
        border: none !important;
        border-color: transparent !important;
        box-shadow: none !important;
        outline: none !important;
        color: #F1F5F9 !important;
        font-size: 0.95rem !important;
        padding: 0 0.75rem 0 0.25rem !important;
    }
    .login-field-input::placeholder {
        color: #64748b !important;
    }
    .login-field-toggle {
        width: 44px !important;
        min-width: 44px !important;
        height: 100% !important;
        display: flex !important;
        align-items: center !important;
        justify-content: center !important;
        color: #A0AABD !important;
        font-size: 1.15rem !important;
        border: none !important;
        background: transparent !important;
        cursor: pointer !important;
        outline: none !important;
        box-shadow: none !important;
        flex-shrink: 0 !important;
        transition: color 0.15s ease !important;
    }
    .login-field-toggle:hover {
        color: #F1F5F9 !important;
    }

    .password-req-box {
        background: rgba(37, 46, 63, 0.4);
        border: 1px solid #30394A;
        border-radius: 8px;
        padding: 0.65rem 0.85rem;
        font-size: 0.78rem;
    }
</style>

<!-- Botón flotante para activar/desactivar sonido -->
<div class="position-fixed top-0 end-0 p-3" style="z-index: 1050;">
    <button type="button" id="soundToggleBtn" onclick="toggleSoundPreference()" class="btn btn-sm btn-outline-secondary d-flex align-items-center gap-1 py-1 px-2 border-0" style="background: rgba(37, 46, 63, 0.7); color: #A0AABD; border-radius: 8px;" title="Activar/desactivar sonidos">
        <i id="soundToggleIcon" class="bi bi-volume-up-fill fs-6"></i>
    </button>
</div>

<div class="no-top-pad container d-flex align-items-center justify-content-center" style="min-height: 100dvh; padding-top: 2rem; padding-bottom: 2rem;">
    <div class="card login-card shadow p-4 p-sm-5" style="width: 100%; max-width: 460px; border-radius: 16px; border: 1px solid #30394A !important; background-color: #191F2C !important; transform: none !important; transition: none !important; cursor: default !important;">
        <div class="text-center mb-4">
            <img src="@config.GetLogoUrl()" class="lubelogger-logo mb-2" style="max-height: 52px; width: auto;" />
            <h4 class="fw-bold mb-1 text-light">Crear Cuenta</h4>
            <div class="small text-secondary">Regístrate para gestionar tus vehículos</div>
        </div>

        <div class="mb-3">
            <label for="inputEmail" class="form-label small fw-semibold text-secondary mb-1">Correo electrónico</label>
            <div class="login-field-box">
                <div class="login-field-icon"><i class="bi bi-envelope"></i></div>
                <input type="email" id="inputEmail" class="login-field-input" value="@Model.EmailAddress" placeholder="tu@correo.com" autocomplete="email">
            </div>
        </div>



        <div class="mb-3">
            <label for="inputUserName" class="form-label small fw-semibold text-secondary mb-1">Nombre de usuario</label>
            <div class="login-field-box">
                <div class="login-field-icon"><i class="bi bi-person"></i></div>
                <input type="text" id="inputUserName" class="login-field-input" placeholder="ejemplo: fernando" autocomplete="username">
            </div>
        </div>

        <div class="mb-3">
            <label for="inputUserPassword" class="form-label small fw-semibold text-secondary mb-1">Contraseña</label>
            <div class="login-field-box">
                <div class="login-field-icon"><i class="bi bi-lock"></i></div>
                <input type="password" id="inputUserPassword" oninput="checkPasswordComplexity(this.value); checkPasswordMatch();" class="login-field-input" placeholder="contraseña segura" autocomplete="new-password">
                <button type="button" class="login-field-toggle" onclick="togglePasswordVisibility(this)" tabindex="-1" title="Mostrar/ocultar contraseña">
                    <i class="bi bi-eye"></i>
                </button>
            </div>
            
            <!-- Requisitos de seguridad en tiempo real -->
            <div class="password-req-box mt-2">
                <div class="fw-semibold text-secondary mb-1">Requisitos de contraseña:</div>
                <div class="d-flex flex-column gap-1">
                    <div id="req-length" class="text-secondary"><i class="bi bi-circle me-1"></i>Mínimo 8 caracteres</div>
                    <div id="req-upper" class="text-secondary"><i class="bi bi-circle me-1"></i>Al menos una letra mayúscula (A-Z)</div>
                    <div id="req-lower" class="text-secondary"><i class="bi bi-circle me-1"></i>Al menos una letra minúscula (a-z)</div>
                    <div id="req-number" class="text-secondary"><i class="bi bi-circle me-1"></i>Al menos un número (0-9)</div>
                    <div id="req-special" class="text-secondary"><i class="bi bi-circle me-1"></i>Al menos un carácter especial (!@@#$%...)</div>
                </div>
            </div>
        </div>

        <div class="mb-3">
            <label for="inputUserPasswordConfirm" class="form-label small fw-semibold text-secondary mb-1">Confirmar contraseña</label>
            <div class="login-field-box">
                <div class="login-field-icon"><i class="bi bi-shield-lock"></i></div>
                <input type="password" id="inputUserPasswordConfirm" oninput="checkPasswordMatch();" onkeyup="callBackOnEnter(event, performRegistration)" class="login-field-input" placeholder="repite tu contraseña" autocomplete="new-password">
                <button type="button" class="login-field-toggle" onclick="togglePasswordVisibility(this)" tabindex="-1" title="Mostrar/ocultar contraseña">
                    <i class="bi bi-eye"></i>
                </button>
            </div>
            <div id="req-match" style="display: none;"></div>
        </div>

        <div class="d-grid mb-3 mt-4">
            <button type="button" class="btn btn-primary py-2 fw-semibold shadow-sm" onclick="performRegistration()">
                <i class="bi bi-person-check me-2"></i>Crear Cuenta
            </button>
        </div>

        <div class="text-center pt-2">
            <a href="/Login/Index" class="small text-decoration-none text-primary fw-semibold">
                <i class="bi bi-arrow-left me-1"></i>Volver a Iniciar Sesión
            </a>
        </div>
    </div>
</div>
<script>
    function togglePasswordVisibility(elem) {
        var group = $(elem).closest('.login-field-box, .login-input-group, .input-group');
        var passwordField = group.find('input');
        if (!passwordField.length) {
            passwordField = $(elem).parent().siblings("input");
        }
        var passwordButton = $(elem).find('.bi');
        if (passwordField.attr("type") === "password") {
            passwordField.attr("type", "text");
            passwordButton.removeClass('bi-eye').addClass('bi-eye-slash');
        } else {
            passwordField.attr("type", "password");
            passwordButton.removeClass('bi-eye-slash').addClass('bi-eye');
        }
    }
</script>
