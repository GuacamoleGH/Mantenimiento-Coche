@using CarCareTracker.Helper
@inject IConfigHelper config
@inject ITranslationHelper translator
@{
    var userLanguage = config.GetServerLanguage();
    var openRegistrationEnabled = config.GetServerOpenRegistration();
}
@model LoginModel
@{
    ViewData["Title"] = "Registro de Usuario";
}
@section Scripts {
    <script src="~/js/login.js?v=@StaticHelper.VersionNumber"></script>
}
<style>
    body {
        background-color: #111722 !important;
        background: #111722 !important;
    }
    .card.login-card,
    .card.login-card:hover,
    [data-bs-theme="dark"] .card.login-card,
    [data-bs-theme="dark"] .card.login-card:hover {
        transform: none !important;
        transition: none !important;
        cursor: default !important;
        background-color: #191F2C !important;
        border: 1px solid #30394A !important;
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.45) !important;
    }
    .login-input-group {
        background-color: #252E3F !important;
        border: 1px solid #30394A !important;
        border-radius: 8px !important;
        overflow: hidden !important;
        display: flex !important;
        align-items: center !important;
        transition: border-color 0.15s ease-in-out, box-shadow 0.15s ease-in-out !important;
        height: 46px !important;
    }
    .login-input-group:focus-within {
        border-color: #FBC41E !important;
        box-shadow: 0 0 0 0.2rem rgba(251, 196, 30, 0.25) !important;
    }
    .login-input-group .input-group-text {
        background: transparent !important;
        background-color: transparent !important;
        border: none !important;
        outline: none !important;
        color: #A0AABD !important;
        width: 44px !important;
        min-width: 44px !important;
        height: 100% !important;
        padding: 0 !important;
        display: flex !important;
        align-items: center !important;
        justify-content: center !important;
        font-size: 1.15rem !important;
        line-height: 1 !important;
        flex-shrink: 0 !important;
    }
    .login-input-group .input-group-text i,
    .login-input-group .input-group-text svg {
        display: inline-flex !important;
        align-items: center !important;
        justify-content: center !important;
        line-height: 1 !important;
    }
    .login-input-group .form-control,
    .login-input-group .form-control:focus,
    .login-input-group input.form-control,
    .login-input-group input.form-control:focus {
        background: transparent !important;
        background-color: transparent !important;
        border: none !important;
        border-color: transparent !important;
        box-shadow: none !important;
        outline: none !important;
        color: #F1F5F9 !important;
        padding-left: 0.25rem !important;
        padding-right: 0.75rem !important;
        height: 100% !important;
        font-size: 0.95rem !important;
    }
    .login-input-group .btn-password-toggle {
        background: transparent !important;
        background-color: transparent !important;
        border: none !important;
        outline: none !important;
        box-shadow: none !important;
        color: #A0AABD !important;
        width: 44px !important;
        min-width: 44px !important;
        height: 100% !important;
        padding: 0 !important;
        cursor: pointer !important;
        display: flex !important;
        align-items: center !important;
        justify-content: center !important;
        font-size: 1.15rem !important;
        line-height: 1 !important;
        flex-shrink: 0 !important;
    }
    .login-input-group .btn-password-toggle:hover {
        color: #F1F5F9 !important;
    }
</style>
<div class="no-top-pad container d-flex align-items-center justify-content-center" style="min-height: 100dvh; padding-top: 2rem; padding-bottom: 2rem;">
    <div class="card login-card shadow p-4 p-sm-5" style="width: 100%; max-width: 440px; border-radius: 16px; border: 1px solid #30394A !important; background-color: #191F2C !important; transform: none !important; transition: none !important; cursor: default !important;">
        <div class="text-center mb-4">
            <img src="@config.GetLogoUrl()" class="lubelogger-logo mb-2" style="max-height: 52px; width: auto;" />
            <h4 class="fw-bold mb-1 text-light">Crear Cuenta</h4>
            <div class="small text-secondary">Regístrate para gestionar tus vehículos</div>
        </div>

        @if (!string.IsNullOrWhiteSpace(Model.Token) || !openRegistrationEnabled)
        {
            <div class="mb-3">
                <label for="inputToken" class="form-label small fw-semibold text-secondary mb-1">Token de Invitación</label>
                <div class="login-input-group input-group">
                    <span class="input-group-text"><i class="bi bi-key"></i></span>
                    <input type="text" id="inputToken" class="form-control" value="@Model.Token" placeholder="Token recibido">
                    @if (openRegistrationEnabled)
                    {
                        <button type="button" class="btn-password-toggle" onclick="sendRegistrationToken()" title="Solicitar token">
                            <i class="bi bi-send"></i>
                        </button>
                    }
                </div>
            </div>
        }

        <div class="mb-3">
            <label for="inputEmail" class="form-label small fw-semibold text-secondary mb-1">Correo electrónico</label>
            <div class="login-input-group input-group">
                <span class="input-group-text"><i class="bi bi-envelope"></i></span>
                <input type="email" id="inputEmail" class="form-control" value="@Model.EmailAddress" placeholder="tu@correo.com">
            </div>
        </div>

        <div class="mb-3">
            <label for="inputUserName" class="form-label small fw-semibold text-secondary mb-1">Nombre de usuario</label>
            <div class="login-input-group input-group">
                <span class="input-group-text"><i class="bi bi-person"></i></span>
                <input type="text" id="inputUserName" class="form-control" placeholder="ejemplo: fernando">
            </div>
        </div>

        <div class="mb-3">
            <label for="inputUserPassword" class="form-label small fw-semibold text-secondary mb-1">Contraseña</label>
            <div class="login-input-group input-group">
                <span class="input-group-text"><i class="bi bi-lock"></i></span>
                <input type="password" id="inputUserPassword" class="form-control" onkeyup="callBackOnEnter(event, performRegistration)" placeholder="contraseña segura">
                <button type="button" class="btn-password-toggle" onclick="togglePasswordVisibility(this)" tabindex="-1" title="Mostrar/ocultar contraseña">
                    <i class="bi bi-eye"></i>
                </button>
            </div>
        </div>

        <div class="d-grid mb-3 mt-4">
            <button type="button" class="btn btn-primary py-2 fw-semibold shadow-sm" onclick="performRegistration()">
                <i class="bi bi-person-check me-2"></i>Registrarse
            </button>
        </div>

        <div class="text-center pt-2">
            <a href="/Login/Index" class="small text-decoration-none text-primary">
                <i class="bi bi-arrow-left me-1"></i>Volver a Iniciar Sesión
            </a>
        </div>
    </div>
</div>
<script>
    function togglePasswordVisibility(elem) {
        var group = $(elem).closest('.input-group, .login-input-group');
        var passwordField = group.find('input');
        if (!passwordField.length) {
            passwordField = $(elem).parent().siblings("input");
        }
        var passwordButton = $(elem).find('.bi');
        if (passwordField.attr("type") === "password") {
            passwordField.attr("type", "text");
            passwordButton.removeClass('bi-eye').addClass('bi-eye-slash');
        } else {
            passwordField.attr("type", "password");
            passwordButton.removeClass('bi-eye-slash').addClass('bi-eye');
        }
    }
</script>
