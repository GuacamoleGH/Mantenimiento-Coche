@using CarCareTracker.Helper
@inject IConfigHelper config
@inject ITranslationHelper translator
@{
    var userLanguage = config.GetServerLanguage();
    var openRegistrationEnabled = config.GetServerOpenRegistration();
}
@model LoginModel
@{
    ViewData["Title"] = "Registro de Usuario";
}
@section Scripts {
    <script src="~/js/login.js?v=@StaticHelper.VersionNumber"></script>
}
<div class="no-top-pad container d-flex align-items-center justify-content-center" style="min-height: 100dvh; padding-top: 2rem; padding-bottom: 2rem;">
    <div class="card shadow border-0 p-4 p-sm-5" style="width: 100%; max-width: 440px; border-radius: 16px;">
        <div class="text-center mb-4">
            <img src="@config.GetLogoUrl()" class="lubelogger-logo mb-2" style="max-height: 52px; width: auto;" />
            <h4 class="fw-bold mb-1">Crear Cuenta</h4>
            <small class="text-muted">Regístrate para gestionar tus vehículos</small>
        </div>

        @if (!string.IsNullOrWhiteSpace(Model.Token) || !openRegistrationEnabled)
        {
            <div class="mb-3">
                <label for="inputToken" class="form-label small fw-semibold text-secondary">@translator.Translate(userLanguage, "Token de Invitación")</label>
                <div class="input-group">
                    <span class="input-group-text bg-body-tertiary border-end-0"><i class="bi bi-key text-secondary"></i></span>
                    <input type="text" id="inputToken" class="form-control border-start-0" value="@Model.Token" placeholder="Token recibido">
                    @if (openRegistrationEnabled)
                    {
                        <button type="button" class="btn btn-outline-secondary" onclick="sendRegistrationToken()" title="Solicitar token">
                            <i class="bi bi-send"></i>
                        </button>
                    }
                </div>
            </div>
        }

        <div class="mb-3">
            <label for="inputEmail" class="form-label small fw-semibold text-secondary">@translator.Translate(userLanguage, "Email Address")</label>
            <div class="input-group">
                <span class="input-group-text bg-body-tertiary border-end-0"><i class="bi bi-envelope text-secondary"></i></span>
                <input type="email" id="inputEmail" class="form-control border-start-0" value="@Model.EmailAddress" placeholder="tu@correo.com">
            </div>
        </div>

        <div class="mb-3">
            <label for="inputUserName" class="form-label small fw-semibold text-secondary">@translator.Translate(userLanguage, "Username")</label>
            <div class="input-group">
                <span class="input-group-text bg-body-tertiary border-end-0"><i class="bi bi-person text-secondary"></i></span>
                <input type="text" id="inputUserName" class="form-control border-start-0" placeholder="nombre de usuario">
            </div>
        </div>

        <div class="mb-3">
            <label for="inputUserPassword" class="form-label small fw-semibold text-secondary">@translator.Translate(userLanguage, "Password")</label>
            <div class="input-group">
                <span class="input-group-text bg-body-tertiary border-end-0"><i class="bi bi-lock text-secondary"></i></span>
                <input type="password" id="inputUserPassword" class="form-control border-start-0 border-end-0" onkeyup="callBackOnEnter(event, performRegistration)" placeholder="contraseña segura">
                <button type="button" class="btn btn-outline-secondary border-start-0" onclick="togglePasswordVisibility(this)" tabindex="-1">
                    <i class="bi bi-eye"></i>
                </button>
            </div>
        </div>

        <div class="d-grid mb-3 mt-4">
            <button type="button" class="btn btn-primary py-2 fw-semibold shadow-sm" onclick="performRegistration()">
                <i class="bi bi-person-check me-2"></i>@translator.Translate(userLanguage, "Register")
            </button>
        </div>

        <div class="text-center">
            <a href="/Login/Index" class="small text-decoration-none text-secondary">
                <i class="bi bi-arrow-left me-1"></i>@translator.Translate(userLanguage, "Back to Login")
            </a>
        </div>
    </div>
</div>
