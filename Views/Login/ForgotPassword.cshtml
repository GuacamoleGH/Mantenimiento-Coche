@using CarCareTracker.Helper
@inject IConfigHelper config
@inject ITranslationHelper translator
@{
    var userLanguage = config.GetServerLanguage();
}
@{
    ViewData["Title"] = "Recuperar Contraseña";
}
@section Scripts {
    <script src="~/js/login.js?v=@StaticHelper.VersionNumber"></script>
}
<style>
    body {
        background-color: #111722 !important;
        background: #111722 !important;
    }
    .card.login-card,
    .card.login-card:hover,
    [data-bs-theme="dark"] .card.login-card,
    [data-bs-theme="dark"] .card.login-card:hover {
        transform: none !important;
        transition: none !important;
        cursor: default !important;
        background-color: #191F2C !important;
        border: 1px solid #30394A !important;
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.45) !important;
    }
    .login-input-group {
        background-color: #252E3F !important;
        border: 1px solid #30394A !important;
    }
    .login-input-group:focus-within {
        border-color: #FBC41E !important;
        box-shadow: 0 0 0 0.2rem rgba(251, 196, 30, 0.25) !important;
    }
</style>
<div class="no-top-pad container d-flex align-items-center justify-content-center" style="min-height: 100dvh; padding-top: 2rem; padding-bottom: 2rem;">
    <div class="card login-card shadow p-4 p-sm-5" style="width: 100%; max-width: 420px; border-radius: 16px; border: 1px solid #30394A !important; background-color: #191F2C !important; transform: none !important; transition: none !important; cursor: default !important;">
        <div class="text-center mb-4">
            <img src="@config.GetLogoUrl()" class="lubelogger-logo mb-2" style="max-height: 52px; width: auto;" />
            <h4 class="fw-bold mb-1 text-light">Recuperar Contraseña</h4>
            <div class="small text-secondary">Introduce tu usuario o correo registrado</div>
        </div>

        <div class="mb-3">
            <label for="inputUserName" class="form-label small fw-semibold text-secondary mb-1">Usuario o correo</label>
            <div class="login-input-group input-group d-flex align-items-center">
                <span class="input-group-text"><i class="bi bi-person"></i></span>
                <input type="text" onkeyup="callBackOnEnter(event, requestPasswordReset)" id="inputUserName" class="form-control" placeholder="tu usuario o correo">
            </div>
        </div>

        <div class="d-grid mb-3 mt-4">
            <button type="button" class="btn btn-primary py-2 fw-semibold shadow-sm" onclick="requestPasswordReset()">
                <i class="bi bi-envelope-arrow-up me-2"></i>Enviar enlace de recuperación
            </button>
        </div>

        <div class="d-flex justify-content-between align-items-center pt-2">
            <a href="/Login/Index" class="small text-decoration-none text-secondary">
                <i class="bi bi-arrow-left me-1"></i>Volver al Login
            </a>
            <a href="/Login/Registration" class="small text-decoration-none text-primary fw-semibold">
                Crear cuenta
            </a>
        </div>
    </div>
</div>
