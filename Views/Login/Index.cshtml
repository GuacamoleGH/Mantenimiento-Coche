@using CarCareTracker.Helper
@inject IConfigHelper config
@inject ITranslationHelper translator
@model string
@{
    var userLanguage = config.GetServerLanguage();
    var registrationDisabled = config.GetServerDisabledRegistration();
    var openIdConfigName = config.GetOpenIDConfig().Name;
    var googleConfig = config.GetGoogleAuthConfig();
    var discordConfig = config.GetDiscordAuthConfig();
}
@{
    ViewData["Title"] = "Iniciar Sesión";
}
@section Scripts {
    <script src="~/js/login.js?v=@StaticHelper.VersionNumber"></script>
}
<div class="no-top-pad container d-flex align-items-center justify-content-center" style="min-height: 100dvh; padding-top: 2rem; padding-bottom: 2rem;">
    <div class="card shadow border-0 p-4 p-sm-5" style="width: 100%; max-width: 420px; border-radius: 16px;">
        <div class="text-center mb-4">
            <img src="@config.GetLogoUrl()" class="lubelogger-logo mb-2" style="max-height: 52px; width: auto;" />
            <h4 class="fw-bold mb-1">Mantenimiento Coche</h4>
            <small class="text-muted">Inicia sesión para gestionar tus vehículos</small>
        </div>

        <!-- Formulario Local -->
        <div class="mb-3">
            <label for="inputUserName" class="form-label small fw-semibold text-secondary">@translator.Translate(userLanguage, "Username")</label>
            <div class="input-group">
                <span class="input-group-text bg-body-tertiary border-end-0"><i class="bi bi-person text-secondary"></i></span>
                <input type="text" id="inputUserName" class="form-control border-start-0" placeholder="usuario o email">
            </div>
        </div>

        <div class="mb-3">
            <div class="d-flex justify-content-between align-items-center">
                <label for="inputUserPassword" class="form-label small fw-semibold text-secondary mb-0">@translator.Translate(userLanguage, "Password")</label>
                <a href="/Login/ForgotPassword" class="small text-decoration-none text-primary">@translator.Translate(userLanguage, "Forgot Password")</a>
            </div>
            <div class="input-group mt-1">
                <span class="input-group-text bg-body-tertiary border-end-0"><i class="bi bi-lock text-secondary"></i></span>
                <input type="password" id="inputUserPassword" onkeyup="callBackOnEnter(event, performLogin)" class="form-control border-start-0 border-end-0" placeholder="••••••••">
                <button type="button" class="btn btn-outline-secondary border-start-0" onclick="togglePasswordVisibility(this)" tabindex="-1"><i class="bi bi-eye"></i></button>
            </div>
        </div>

        <div class="form-check form-switch mb-3">
            <input class="form-check-input" type="checkbox" role="switch" id="inputPersistent">
            <label class="form-check-label small text-secondary" for="inputPersistent">@translator.Translate(userLanguage, "Remember Me")</label>
        </div>

        <div class="d-grid mb-3">
            <button type="button" class="btn btn-primary py-2 fw-semibold shadow-sm" onclick="performLogin()">
                <i class="bi bi-box-arrow-in-right me-2"></i>@translator.Translate(userLanguage, "Login")
            </button>
        </div>

        <!-- Divisor Social -->
        <div class="d-flex align-items-center my-2">
            <hr class="flex-grow-1 my-0 opacity-25">
            <span class="px-2 text-muted small user-select-none">o accede con</span>
            <hr class="flex-grow-1 my-0 opacity-25">
        </div>

        <!-- Botones de Inicio de Sesión Social -->
        <div class="d-grid gap-2 mt-2">
            <!-- Google -->
            <a href="/Login/GoogleLogin" class="btn btn-outline-secondary d-flex align-items-center justify-content-center gap-2 py-2 text-decoration-none">
                <svg width="18" height="18" viewBox="0 0 24 24">
                    <path fill="#4285F4" d="M23.745 12.27c0-.7-.06-1.4-.19-2.07H12v4.51h6.6c-.29 1.52-1.14 2.82-2.4 3.68v3.05h3.88c2.27-2.09 3.665-5.17 3.665-9.17z"/>
                    <path fill="#34A853" d="M12 24c3.24 0 5.95-1.08 7.93-2.91l-3.88-3.05c-1.08.72-2.45 1.16-4.05 1.16-3.12 0-5.77-2.1-6.72-4.93H1.25v3.15C3.26 21.36 7.33 24 12 24z"/>
                    <path fill="#FBBC05" d="M5.28 14.27c-.25-.72-.38-1.49-.38-2.27s.13-1.55.38-2.27V6.58H1.25C.45 8.18 0 9.99 0 12s.45 3.82 1.25 5.42l4.03-3.15z"/>
                    <path fill="#EA4335" d="M12 4.75c1.77 0 3.35.61 4.6 1.8l3.42-3.42C17.95 1.19 15.24 0 12 0 7.33 0 3.26 2.64 1.25 6.58l4.03 3.15c.95-2.83 3.6-4.98 6.72-4.98z"/>
                </svg>
                <span class="fw-semibold">Google</span>
            </a>

            <!-- Discord -->
            <a href="/Login/DiscordLogin" class="btn text-white d-flex align-items-center justify-content-center gap-2 py-2 text-decoration-none" style="background-color: #5865F2;">
                <i class="bi bi-discord fs-5"></i>
                <span class="fw-semibold">Discord</span>
            </a>

            @if (!string.IsNullOrWhiteSpace(openIdConfigName))
            {
                <button type="button" class="btn btn-secondary py-2" onclick="remoteLogin()">
                    <i class="bi bi-shield-lock me-2"></i>@($"{translator.Translate(userLanguage, "Login via")} {openIdConfigName}")
                </button>
            }
        </div>

        @if (!string.IsNullOrWhiteSpace(config.GetMOTD()))
        {
            <div class="text-center mt-3">
                <small class="text-muted">@config.GetMOTD()</small>
            </div>
        }

        @if (!registrationDisabled)
        {
            <div class="text-center mt-4 pt-2 border-top">
                <span class="small text-secondary">¿No tienes cuenta?</span>
                <a href="/Login/Registration" class="small fw-semibold text-primary text-decoration-none ms-1">@translator.Translate(userLanguage, "Register")</a>
            </div>
        }
    </div>
</div>
<script>
    function getRedirectURL() {
        return { url: decodeHTMLEntities('@Model') };
    }
    checkPersistLoginState();
</script>
