# ==============================================================================
# Mantenimiento-Coche - Archivo de Configuración de Entorno (.env.example)
# ==============================================================================
# Copia este archivo a `.env` para desarrollo local o configura estas variables
# en tu docker-compose.yml / entorno de despliegue.
# NUNCA subas tu archivo `.env` real al repositorio de Git.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Autenticación y Control de Acceso
# ------------------------------------------------------------------------------
# Habilita el sistema de login y permisos (true para producción y pruebas de auth)
EnableAuth=true

# Deshabilita el registro público de nuevos usuarios
# Recomendación: 'false' para crear tu cuenta inicial, luego cambiar a 'true' en producción
DisableRegistration=false

# ------------------------------------------------------------------------------
# 2. Credenciales del Usuario Root / Administrador del Sistema
# ------------------------------------------------------------------------------
# El usuario root se define mediante hashes SHA-256 en hexadecimal (minúsculas).
# Puedes generarlos en PowerShell con:
#   $texto = "admin" # o tu contraseña
#   [BitConverter]::ToString([System.Security.Cryptography.SHA256]::Create().ComputeHash([System.Text.Encoding]::UTF8.GetBytes($texto))).Replace("-","").ToLower()
#
# Ejemplo para usuario "admin":
UserNameHash=8c6976e5b5410415bde908bd4dee15dfb167a9c873fc4bb8a81f6f2ab448a918
# Ejemplo para contraseña "admin" (¡CÁMBIALA EN PRODUCCIÓN!):
UserPasswordHash=8c6976e5b5410415bde908bd4dee15dfb167a9c873fc4bb8a81f6f2ab448a918

# ------------------------------------------------------------------------------
# 3. Proveedores de Identidad Social (OAuth 2.0)
# ------------------------------------------------------------------------------
# Google OAuth 2.0 (Google Cloud Console -> APIs y Servicios -> Credenciales)
# Redirect URI: http://localhost:5000/Login/GoogleCallback (o tu dominio con HTTPS)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Discord OAuth 2.0 (Discord Developer Portal -> Applications -> OAuth2)
# Redirect URI: http://localhost:5000/Login/DiscordCallback (o tu dominio con HTTPS)
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Dominio público para callbacks OAuth en producción (evita manipulación de Host header)
# Ejemplo: https://coche.tudominio.com
LUBELOGGER_DOMAIN=

# ------------------------------------------------------------------------------
# 4. Base de Datos
# ------------------------------------------------------------------------------
# En local sin Docker se usa LiteDB automáticamente (data/lubelogger.db).
# Para usar PostgreSQL en producción o Docker, descomenta y configura la cadena:
# POSTGRES_CONNECTION=Host=localhost;Username=postgres;Password=TU_PASSWORD_AQUI;Database=lubelogger;
POSTGRES_CONNECTION=

# ------------------------------------------------------------------------------
# 5. Configuración Regional y Servidor
# ------------------------------------------------------------------------------
ASPNETCORE_ENVIRONMENT=Development
LUBELOGGER_LOCALE_OVERRIDE=es-ES
LUBELOGGER_LOCALE_DT_OVERRIDE=es-ES
